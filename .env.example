# Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# YouTube Data API v3
# Google Cloud Console → APIs & Services → Credentials → API Key erstellen
# Dann YouTube Data API v3 aktivieren
VITE_YOUTUBE_API_KEY=your_youtube_api_key

# Push Notifications (VAPID)
# Keys erzeugen mit: npx web-push generate-vapid-keys
# Ohne diese Keys sind Benachrichtigungen komplett aus (die App läuft trotzdem).
# VITE_VAPID_PUBLIC_KEY muss auch auf dem Server gesetzt sein — die API nutzt sie.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=deine@email.de

# Firebase Admin (Server: /api/notify-round + /api/send-notifications)
# Firebase Console → Projekteinstellungen → Dienstkonten → Neuen Schlüssel erzeugen
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CRON_SECRET=your_secret_password
